load("@com_google_protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load(
    "//:build_defs.bzl",
    "mozc_cc_binary",
    "mozc_cc_library",
)

package(default_visibility = ["//:__subpackages__"])

mozc_cc_library(
    name = "uim_key_translator",
    srcs = [
        "key_translator.cc",
    ],
    hdrs = [
        "key_translator.h",
    ],
    deps = [
        "//base:port",
        "//base:vlog",
        "//protocol:commands_cc_proto",
        "@com_google_absl//absl/log:check",
        "@uim",
    ],
)

mozc_cc_binary(
    name = "libuim-mozc.so",
    srcs = ["mozc.cc"],
    additional_linker_inputs = ["mozc.map"],
    linkopts = [
        # Hide every symbol except the two uim plugin entry points so this
        # plugin's statically-linked protobuf/absl cannot be interposed by
        # (or interpose) a different libprotobuf/libabsl already loaded in
        # the host process (e.g. digiKam). See mozc.map for details.
        #
        # The real, compiled entry-point names are uim_dynlib_instance_init
        # and uim_dynlib_instance_quit (see mozc.map's comment for why --
        # short version: dynlib.h #defines the uim_plugin_instance_* names
        # mozc.cc actually writes to these before compilation).
        "-Wl,--undefined=uim_dynlib_instance_init",
        "-Wl,--undefined=uim_dynlib_instance_quit",
        "-Wl,--version-script=$(location mozc.map)",
        "-Wl,-Bsymbolic-functions",
    ],
    linkshared = 1,
    linkstatic = 1,
    deps = [
        ":uim_key_translator",
        "//base:init_mozc",
        "//client",
        "//protocol:commands_cc_proto",
        "//protocol:config_cc_proto",
        "@uim",
    ],
)
